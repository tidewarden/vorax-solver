// The live-data collector: a Cloudflare Worker with a D1 database.
// Deploy from this folder with `npx wrangler deploy`. The two secrets (EXPORT_TOKEN, IP_SALT) are set with
// `npx wrangler secret put`, never here. Every value in this file is safe to publish.
{
  "name": "vorax-live",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vorax-live",
      // from `npx wrangler d1 create vorax-live`
      "database_id": "e28f0ad3-1fe8-419d-b374-2f9b630c1efa"
    }
  ],
  // per address: at most 60 uploads a minute (each carries up to 10 boards)
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true },
  // training data (src/training.ts): "on" to take screenshots of cards the reader is short of; off since 2026-10-29
  // COLLECTING (src/index.ts): "on" to keep the boards, icons and cards the Solver sends; off since 2026-10-29, when
  // the nightly jobs that pulled and emptied them stopped
  "vars": { "TRAINING_UPLOADS": "off", "COLLECTING": "off" },
  // the repo's loops, started on time (src/schedule.ts)
  "triggers": { "crons": ["33 4 * * *", "17 */2 * * *"] }
}
